# Copié en ~/lucioles/.env (chmod 600) : NE JAMAIS versionner ce fichier une fois rempli.
# Identifiants d'un utilisateur IAM dédié, limité à votre bucket (voir docs/DEPLOIEMENT-ALWAYSDATA.md).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-3
LUCIOLES_S3_BUCKET=

# Optionnel (étapes 'save: postgres' et historique des exécutions) :
# LUCIOLES_DATABASE_URL=postgresql://utilisateur:motdepasse@postgresql-<compte>.alwaysdata.net:5432/<base>
